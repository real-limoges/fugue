# Required: generate with `mix phx.gen.secret`
SECRET_KEY_BASE=

# Optional: public hostname (default: localhost)
PHX_HOST=localhost

# Optional: port to expose on the host (default: 4000)
PORT=4000

# Service URLs (set automatically by docker-compose, override for standalone dev)
# ISH_URL=http://localhost:7333
# COZODB_URL=http://localhost:3000
