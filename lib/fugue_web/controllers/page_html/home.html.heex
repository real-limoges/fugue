<div
  class="relative -mt-12 overflow-hidden"
  style="height: calc(100vh - 8rem); width: 100vw; margin-left: calc(50% - 50vw);"
>
  <canvas id="petri-canvas" class="absolute inset-0 w-full h-full object-cover"></canvas>

  <%!-- The overlay sits on the splash in both themes, so it takes the theme's
  text color and a halo in the background color, which lifts it off the
  trails whichever way the palette runs. --%>
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 [text-shadow:0_0_6px_var(--color-base-100),0_0_2px_var(--color-base-100)]">
    <p class="font-mono text-base-content/70 text-xs uppercase tracking-[0.25em]">
      what simple rules become
    </p>
    <a
      href="/mood"
      class="group font-mono text-xl tracking-wider text-base-content hover:text-primary transition-colors"
    >
      moods
      <span
        aria-hidden="true"
        class="inline-block text-base-content/60 transition-all group-hover:text-primary group-hover:translate-x-1"
      >
        &rarr;
      </span>
    </a>
  </div>

  <div class="absolute bottom-6 left-6 flex flex-col gap-2 [text-shadow:0_0_6px_var(--color-base-100)]">
    <p
      id="sim-reading"
      aria-hidden="true"
      class="font-mono text-[10px] text-base-content/60 tracking-wider tabular-nums min-h-[1em]"
    >
    </p>
    <select
      id="sim-picker"
      class="select select-xs select-ghost font-mono text-xs !text-base-content/80 hover:!text-primary transition-colors"
    >
      <option value="boids">boids</option>
      <option value="langton">langton's ant</option>
      <option value="oscillators">oscillators</option>
    </select>
  </div>

  <a
    href="/about"
    class="absolute bottom-6 right-6 font-mono text-xs text-base-content/70 hover:text-primary tracking-wider transition-colors [text-shadow:0_0_6px_var(--color-base-100)]"
  >
    about
  </a>
</div>

<.source_link repos={["petri", {"fugue", "assets/js/petri_splash.js"}]} />
