<div
  class="relative -mt-12 overflow-hidden"
  style="height: calc(100vh - 8rem); width: 100vw; margin-left: calc(50% - 50vw);"
>
  <canvas id="petri-canvas" class="absolute inset-0 w-full h-full object-cover"></canvas>

  <div class="absolute inset-0 flex flex-col items-center justify-center gap-5">
    <p class="font-mono text-white/60 text-xs uppercase tracking-[0.25em]">
      what simple rules become
    </p>
    <a
      href="/mood"
      class="group font-mono text-xl tracking-wider text-white/90 hover:text-white transition-colors"
    >
      moods
      <span
        aria-hidden="true"
        class="inline-block text-white/40 transition-all group-hover:text-white group-hover:translate-x-1"
      >
        &rarr;
      </span>
    </a>
  </div>

  <div class="absolute bottom-6 left-6 flex flex-col gap-2">
    <p
      id="sim-reading"
      aria-hidden="true"
      class="font-mono text-[10px] text-white/40 tracking-wider tabular-nums min-h-[1em]"
    >
    </p>
    <select
      id="sim-picker"
      class="select select-xs select-ghost font-mono text-xs !text-white/70 hover:!text-white transition-colors"
    >
      <option value="boids">boids</option>
      <option value="langton">langton's ant</option>
      <option value="oscillators">oscillators</option>
    </select>
  </div>
</div>
