<div
  class="relative -mt-12 overflow-hidden"
  style="height: calc(100vh - 8rem); width: 100vw; margin-left: calc(50% - 50vw);"
>
  <canvas id="petri-canvas" class="absolute inset-0 w-full h-full object-cover"></canvas>
  <div class="absolute inset-0 flex items-end justify-center pb-12">
    <div class="text-center space-y-4 px-4 py-3 rounded-box backdrop-blur-sm bg-base-100/20">
      <div class="space-y-4">
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight">
          <span class="text-primary">Real -&gt; Complex</span>
        </h1>
        <p class="font-mono text-base-content/70 text-sm">
          computational tools for complex systems
        </p>
      </div>
      <div class="flex justify-center items-center gap-3">
        <a href="/mood" class="btn btn-primary btn-sm font-mono tracking-wider glow-hover">
          mood journal
        </a>
        <select id="sim-picker" class="select select-sm select-ghost font-mono text-xs">
          <option value="boids">boids</option>
          <option value="langton">langton's ant</option>
          <option value="oscillators">oscillators</option>
        </select>
      </div>
    </div>
  </div>
</div>
