<div class="blog-page max-w-2xl mx-auto space-y-10">
  <div class="space-y-2">
    <h1 class="text-4xl font-bold tracking-tight">
      <span class="font-mono text-primary">#</span> Blog
    </h1>
    <p class="text-base-content/50 font-mono text-sm">thoughts on systems, sound, and software</p>
    <hr class="divider-accent mt-4" />
  </div>

  <div class="flex flex-wrap gap-2">
    <a
      href="/blog"
      class={[
        "font-mono text-xs px-3 py-1 rounded border transition-all",
        if(!@current_tag,
          do: "border-primary text-primary bg-primary/10",
          else: "border-base-300 text-base-content/50 hover:border-primary/50 hover:text-primary"
        )
      ]}
    >
      all
    </a>
    <%= for tag <- @tags do %>
      <a
        href={"/blog?tag=#{tag}"}
        class={[
          "font-mono text-xs px-3 py-1 rounded border transition-all",
          if(@current_tag == tag,
            do: "border-primary text-primary bg-primary/10",
            else:
              "border-base-300 text-base-content/50 hover:border-primary/50 hover:text-primary"
          )
        ]}
      >
        {tag}
      </a>
    <% end %>
  </div>

  <div class="space-y-4">
    <%= for post <- @posts do %>
      <a
        href={"/blog/#{post.slug}"}
        class="group block border border-base-300/50 rounded-md p-6 hover:border-primary/50 transition-all glow-hover bg-base-200/30"
      >
        <div class="flex items-start justify-between gap-4">
          <h2 class="text-lg font-semibold group-hover:text-primary transition-colors">
            {post.title}
          </h2>
          <%= if post.date do %>
            <time class="text-xs font-mono text-base-content/40 whitespace-nowrap mt-1">
              {Calendar.strftime(post.date, "%b %d, %Y")}
            </time>
          <% end %>
        </div>
        <%= if post.summary != "" do %>
          <p class="text-base-content/60 mt-2 text-sm leading-relaxed">{post.summary}</p>
        <% end %>
        <%= if post.tags != [] do %>
          <div class="flex flex-wrap gap-1.5 mt-3">
            <%= for tag <- post.tags do %>
              <span class={"font-mono text-xs px-2 py-0.5 rounded border #{FugueWeb.BlogHTML.tag_classes(tag)}"}>
                {tag}
              </span>
            <% end %>
          </div>
        <% end %>
      </a>
    <% end %>
  </div>
</div>
