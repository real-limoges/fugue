<div class="blog-page max-w-2xl mx-auto">
  <a
    href="/blog"
    class="inline-flex items-center gap-1 text-sm font-mono text-base-content/40 hover:text-primary transition-colors mb-8"
  >
    <span>&larr;</span> <span>blog</span>
  </a>

  <article>
    <header class="mb-10 pb-8 border-b-2 border-primary/30">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight">{@post.title}</h1>
      <div class="flex flex-wrap items-center gap-3 mt-4 text-sm font-mono text-base-content/40">
        <%= if @post.date do %>
          <time>{Calendar.strftime(@post.date, "%b %d, %Y")}</time>
        <% end %>
        <%= if @post.tags != [] do %>
          <span class="text-base-content/20">|</span>
          <div class="flex flex-wrap gap-2">
            <%= for tag <- @post.tags do %>
              <a
                href={"/blog?tag=#{tag}"}
                class={"font-mono text-xs px-2 py-0.5 rounded border transition-colors #{FugueWeb.BlogHTML.tag_classes(tag)}"}
              >
                {tag}
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>

    <div class="prose prose-lg max-w-none
      prose-headings:text-base-content prose-headings:font-bold prose-headings:tracking-tight
      prose-p:text-base-content/80 prose-p:leading-relaxed
      prose-li:text-base-content/80
      prose-strong:text-base-content
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-blockquote:border-primary/50 prose-blockquote:text-base-content/60
      prose-hr:border-base-300/50
      prose-img:rounded-md prose-img:border prose-img:border-base-300/50">
      {raw(@post.body)}
    </div>
  </article>

  <div class="border-t-2 border-primary/30 mt-12 pt-8">
    <a
      href="/blog"
      class="inline-flex items-center gap-1 text-sm font-mono text-base-content/40 hover:text-primary transition-colors"
    >
      <span>&larr;</span> <span>back to all posts</span>
    </a>
  </div>
</div>
