<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <%!-- Mobile browser bar color. The theme script below picks the value
    for the resolved theme, and ThemeToggle updates it on every flip. --%>
    <meta name="theme-color" content="#140d20" data-dark="#140d20" data-light="#f2e9d8" />
    <script>
      (() => {
        const stored = localStorage.getItem("fugue-theme");
        const theme =
          stored ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        const bar = document.querySelector('meta[name="theme-color"]');
        bar.setAttribute("content", bar.dataset[theme]);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Fugue" suffix=" · realcomplex.systems">
      {assigns[:page_title]}
    </.live_title>
    <%= if assigns[:meta_description] do %>
      <meta name="description" content={@meta_description} />
      <meta property="og:description" content={@meta_description} />
    <% end %>
    <%= if assigns[:page_title] do %>
      <meta property="og:title" content={@page_title} />
    <% end %>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="realcomplex.systems" />
    <meta property="og:url" content={page_url(@conn)} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={page_url(@conn)} />
    <%!-- Web fonts are per page: only a page that sets `font_stylesheet`
    (today, /amigos) talks to Google Fonts. --%>
    <%= if assigns[:font_stylesheet] do %>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href={@font_stylesheet} rel="stylesheet" />
    <% end %>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="realcomplex.systems updates"
      href={~p"/feed.xml"}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:px-3 focus:py-2 focus:bg-base-100 focus:text-primary focus:border focus:border-primary font-mono text-xs"
    >
      skip to content
    </a>

    <header class="border-b-2 border-primary/30 backdrop-blur-sm sticky top-0 z-50 bg-base-100/80">
      <nav class="navbar px-4 sm:px-6 lg:px-8">
        <div class="flex-1">
          <a
            href="/"
            class="flex items-center gap-2 font-bold text-lg tracking-tight hover:text-primary transition-colors"
          >
            <span class="font-mono text-primary">Real -&gt; Complex</span>
          </a>
        </div>
        <div class="flex-none">
          <ul class="flex px-1 space-x-1 items-center">
            <li><.nav_link href="/mood" current_path={@conn.request_path}>Mood</.nav_link></li>
            <li><.nav_link href="/color" current_path={@conn.request_path}>Color</.nav_link></li>
            <li>
              <.nav_link href="/menagerie" current_path={@conn.request_path}>Menagerie</.nav_link>
            </li>
            <li>
              <button
                id="theme-toggle"
                type="button"
                phx-hook="ThemeToggle"
                phx-update="ignore"
                class="btn btn-ghost btn-sm btn-square"
                aria-label="Toggle light and dark theme"
                title="Toggle light and dark theme"
              >
                <span class="hero-sun-solid size-4 dark:hidden"></span>
                <span class="hero-moon-solid size-4 hidden dark:inline-block"></span>
              </button>
            </li>
          </ul>
        </div>
      </nav>
    </header>

    <main
      id="main"
      tabindex="-1"
      class="px-4 py-12 sm:px-6 lg:px-8 min-h-[calc(100vh-8rem)] focus:outline-none"
    >
      <div class="mx-auto max-w-5xl">
        {@inner_content}
      </div>
    </main>

    <footer class="border-t-2 border-primary/30 py-5 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-base-content/65 dark:text-base-content/40 font-mono">
        <span>&copy; {Date.utc_today().year} realcomplex.systems</span>
        <div class="flex items-center gap-4">
          <a href="/about" class="hover:text-primary transition-colors">
            about
          </a>
          <a href="/code" class="hover:text-primary transition-colors">
            code
          </a>
          <a href="/amigos" class="hover:text-primary transition-colors">
            amigos
          </a>
          <a href={~p"/feed.xml"} class="hover:text-primary transition-colors" title="RSS feed">
            feed
          </a>
          <a href="https://github.com/real-limoges" class="hover:text-primary transition-colors">
            github
          </a>
        </div>
      </div>
    </footer>

    <.connection_status />
  </body>
</html>
