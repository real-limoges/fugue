# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Mix 1.19+ cross-process lock/pubsub dirs (leak into CWD when TMPDIR points here).
/mix_lock_user*/
/mix_pubsub_user*/

# Ignore package tarball (built via "mix hex.build").
fugue-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/
/priv/static/vendor/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/
/.idea/
/docs/

docker-compose.yml
Dockerfile.cozodb

# Local env files (but NOT .env.example — that's the template)
.env
.env.local

node-compile-cache/

CLAUDE.md
**/CLAUDE.md

# Local color-chapter scratch data (not loaded at runtime; runtime data is
# inlined in Fugue.Color.* — see priv/color/CLAUDE.md)
/priv/color/

# Playwright MCP artifacts
.playwright-mcp/
mood-*.png
color-*.png
menagerie-*.png

# the annoying MacOS thing
.DS_Store

# working notes and drafts; see docs/private-notes/README.md
docs/private-notes/
