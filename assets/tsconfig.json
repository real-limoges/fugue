// Type checking for the JS hooks, run by `mix assets.typecheck` (tsc --noEmit).
// esbuild does the actual build and ignores this file.
//
// Gradual: `checkJs` is off, so a file is checked only once it opts in with a
// `// @ts-check` first line. An opted-in file is either clean or carries a
// `@ts-expect-error` with a comment saying why.
//
// phoenix, phoenix_html and phoenix_live_view are not npm packages here;
// esbuild finds them in ../deps through NODE_PATH, and `paths` mirrors that.
// LiveView ships its own types (its package.json points at them).
// phoenix ships none, and its bundle is opaque to inference, so the `phoenix`
// entry points at @types/phoenix (the package LiveView's own types expect).
//
// glissando is loaded at runtime from the URL priv/static serves it at; the
// second `paths` entry points that URL at the vendored copy, whose
// wasm-bindgen JSDoc supplies the types. Vendor files are read, never checked.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "paths": {
      "/vendor/glissando/glissando.js": ["./vendor/glissando/glissando.js"],
      "phoenix": ["./node_modules/@types/phoenix"],
      "*": ["../deps/*"]
    }
  },
  "include": ["js/**/*"]
}
