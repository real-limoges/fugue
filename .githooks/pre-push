#!/usr/bin/env bash
# Run the same checks CI does before allowing a push.
# Bypass with: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> mix precommit (compile, format, credo, dialyzer, assets, tests)"
mix precommit

# CI runs this as its own job on PRs, outside the deploy path. Here it catches
# a new advisory before the PR does.
echo "==> mix audit (Hex and npm advisories)"
mix audit
