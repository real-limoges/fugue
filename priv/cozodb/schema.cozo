# Fugue graph schema for CozoDB
# Usage: POST each block to http://localhost:9070/text-query as {"script": "...", "params": {}}
# Or run: cozo-bin import priv/cozodb/schema.cozo

# Article relation
::relation create article {
  id: String
  =>
  title: String,
  abstract: String default "",
  is_disambiguation: Bool default false,
  timestamp: String default "",
  in_degree: Int default 0,
  out_degree: Int default 0,
  pagerank: Float default 0.0
}

# Links between articles
::relation create links_to {
  source: String,
  target: String
  =>
  link_type: String default "LINKS_TO"
}

# Category relation
::relation create category {
  id: String
  =>
  name: String
}

# Article-to-category mapping
::relation create categorized_as {
  article_id: String,
  category_id: String
}

# Full-text search index on article titles
::fts create article:title_fts {
  extractor: title,
  tokenizer: Simple,
  filters: [Lowercase, AsciiFolding]
}
